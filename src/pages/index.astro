---
import Layout from '../layouts/Layout.astro';
import PostListing from '../components/PostListing.astro';
import ProjectListing from '../components/ProjectListing.astro';
import SimpleListing from '../components/SimpleListing.astro';
import config from '../config';
import projects from '../../data/projects';
import training from '../../data/training';
import { getPosts, getPopularPosts } from '../utils/posts';

const allPosts = getPosts();
const latestPosts = allPosts.slice(0, 5);
const popularPosts = getPopularPosts().slice(0, 9);

const trainingData = training.map((t) => ({
  ...t,
  img: typeof t.img === 'string' ? t.img.replace(/^.*\/thumbnails\//, '/thumbnails/') : '/thumbnails/certificate.png',
}));
---
<Layout
  title="Catatan Harian & Rekayasa Perangkat Lunak"
  description="Catatan teknis dan dokumentasi Steven Lavinske seputar rekayasa perangkat lunak, arsitektur sistem, Linux, dan otomasi homelab."
>
  <div class="container">
    <div class="lead">
      <div class="elevator">
        <h1 class="hero-headline">
          <span class="hero-greeting">Halo, saya Steven.</span>
          <span class="hero-cursor-wrapper">
            <span id="hero-typewriter">Software Engineer</span>
            <span class="hero-cursor" aria-hidden="true"></span>
          </span>
        </h1>
        <p>
          Software engineer yang berfokus pada arsitektur sistem, automasi infrastruktur, dan pengembangan web.
          Di sini saya menulis catatan teknis, dokumentasi project{' '}
          <a href="https://github.com/lavinske" target="_blank" rel="noopener noreferrer">
            open source
          </a>,
          dan eksplorasi homelab yang saya tekuni.
        </p>
        <div class="social-buttons">
          <a class="button" href="https://github.com/lavinske" target="_blank" rel="noopener noreferrer">
            GitHub @lavinske
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="container front-page">
    <section class="section">
      <h2>
        Tulisan Terbaru
        <a href="/blog/" class="view-all">Lihat Semua</a>
      </h2>
      <PostListing simple posts={latestPosts} />
    </section>

    {popularPosts.length > 0 && (
      <section class="section">
        <h2>
          Tulisan Terpopuler
          <a href="/categories/populer/" class="view-all">Lihat Semua</a>
        </h2>
        <PostListing simple posts={popularPosts} />
      </section>
    )}

    <section class="section">
      <h2>Project</h2>
      <ProjectListing projects={projects} />
    </section>

    <section class="section">
      <h2>
        Pelatihan dan Sertifikasi
        <a href="/training/" class="view-all">Lihat Semua</a>
      </h2>
      <SimpleListing data={trainingData} />
    </section>
  </div>
</Layout>

<script is:inline>
  (function() {
    const roles = [
      'Software Engineer',
      'Systems Architect',
      'Infrastructure Explorer',
      'Homelab Builder',
      'Open Source Enthusiast'
    ];
    const el = document.getElementById('hero-typewriter');
    if (!el || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let roleIdx = 0;
    let charIdx = roles[0].length;
    let isDeleting = true;
    let speed = 70;

    function type() {
      const currentRole = roles[roleIdx];

      if (isDeleting) {
        charIdx--;
        el.textContent = currentRole.substring(0, charIdx);
        speed = 35;
      } else {
        charIdx++;
        el.textContent = currentRole.substring(0, charIdx);
        speed = 75;
      }

      if (!isDeleting && charIdx === currentRole.length) {
        speed = 2200;
        isDeleting = true;
      } else if (isDeleting && charIdx === 0) {
        isDeleting = false;
        roleIdx = (roleIdx + 1) % roles.length;
        speed = 400;
      }

      setTimeout(type, speed);
    }

    setTimeout(type, 1800);
  })();
</script>
