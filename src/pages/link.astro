---
import Layout from '../layouts/Layout.astro';
import config from '../config';

const links = [
  {
    title: 'Blog & Artikel',
    description: 'Catatan teknis, arsitektur sistem, dan eksplorasi homelab',
    url: '/blog/',
    displayUrl: 'lav.my.id/blog',
    internal: true,
    badge: 'Artikel',
  },
  {
    title: 'LinkedIn',
    description: 'Profil profesional dan riwayat karier',
    url: 'https://go.tell.my.id/lin',
    displayUrl: 'go.tell.my.id/lin',
    internal: false,
    badge: 'Karier',
  },
  {
    title: 'GitHub',
    description: 'Repositori open source, project, dan otomasi',
    url: 'https://go.tell.my.id/github',
    displayUrl: 'github.com/lavinske',
    internal: false,
    badge: 'Kode',
  },
  {
    title: 'Email',
    description: 'Korespondensi dan pesan langsung',
    url: 'https://go.tell.my.id/mail',
    displayUrl: 'go.tell.my.id/mail',
    internal: false,
    badge: 'Kontak',
  },
];
---
<Layout title="Tautan">
  <div class="container">
    <div class="lead">
      <div class="elevator" style="text-align: center;">
        <img
          src="/logos/hd.png"
          alt={config.siteTitle}
          class="avatar"
          style="display: block; margin: 0 auto 1.25rem; width: 90px; height: 90px; object-fit: cover;"
        />
        <h1 style="margin-bottom: 0.35rem;">{config.siteTitle}</h1>
        <p style="margin: 0 auto; max-width: 520px; font-size: 0.95rem; line-height: 1.6; color: inherit; opacity: 0.88;">
          Sysadmin & technology enthusiast, focusing on Enterprise Infrastructure and Networking. Exploring automation and agentic tools technology.
        </p>
      </div>
    </div>

    <div class="link-directory">
      {links.map((item) => (
        <a
          href={item.url}
          class="link-row"
          target={item.internal ? '_self' : '_blank'}
          rel={item.internal ? '' : 'noopener noreferrer'}
        >
          <div class="link-main">
            <div class="link-head">
              <span class="link-title">{item.title}</span>
              <span class="link-badge">{item.badge}</span>
            </div>
            <p class="link-desc">{item.description}</p>
            <span class="link-url">{item.displayUrl}</span>
          </div>
          <div class="link-action">
            <span class="button action-button">
              {item.internal ? 'Buka →' : 'Kunjungi ↗'}
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
