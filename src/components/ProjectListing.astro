---
interface Props {
  projects: any[];
}

const { projects } = Astro.props;
---
<section class="projects">
  {projects.map((project) => (
    <div class="each">
      <h2>
        <a
          class="project-link"
          href={project.source || project.path}
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="project-icon">{project.icon}</div>
          <div class="project-title">{project.title}</div>
        </a>
      </h2>
      <p>{project.description}</p>
      <div class="buttons">
        {project.source && (
          <a class="button" href={project.source} target="_blank" rel="noopener noreferrer">
            Sumber
          </a>
        )}
        {project.path && (
          <a class="button" href={project.path} target="_blank" rel="noopener noreferrer">
            Tautan
          </a>
        )}
      </div>
    </div>
  ))}
</section>
