---
import { getPosts, resolveThumbnail, getReadingTime } from '../utils/posts';
import moment from 'moment';
import 'moment/locale/id';
import config from '../config';

interface Props {
  currentSlug: string;
  tags?: string[];
  categories?: string[];
}

const { currentSlug, tags = [], categories = [] } = Astro.props;
const allPosts = getPosts().filter((p) => p.frontmatter?.slug !== currentSlug);

// Score candidates by overlapping tags and categories
const scored = allPosts.map((post) => {
  let score = 0;
  const postTags = post.frontmatter?.tags || [];
  const postCategories = post.frontmatter?.categories || [];

  for (const tag of tags) {
    if (postTags.includes(tag)) score += 2;
  }
  for (const cat of categories) {
    if (postCategories.includes(cat)) score += 1;
  }

  return { post, score };
});

scored.sort((a, b) => {
  if (b.score !== a.score) return b.score - a.score;
  const dateA = new Date(a.post.frontmatter?.date || 0).getTime();
  const dateB = new Date(b.post.frontmatter?.date || 0).getTime();
  return dateB - dateA;
});

const related = scored.slice(0, 3).map((item) => item.post);
---

{related.length > 0 && (
  <section class="related-posts container" aria-label="Artikel Terkait">
    <div class="related-header">
      <h3>Baca Selanjutnya</h3>
      <div class="related-header-line"></div>
    </div>
    <div class="related-grid">
      {related.map((post) => {
        const thumb = resolveThumbnail(post.frontmatter?.thumbnail);
        const dateStr = post.frontmatter?.date
          ? moment.utc(post.frontmatter.date).locale('id').format(config.dateFormat)
          : '';
        const readTime = getReadingTime(post);

        return (
          <a href={`/${post.frontmatter.slug}/`} class="related-card">
            {thumb ? (
              <div class="related-thumb-wrapper">
                <img src={thumb} alt={post.frontmatter.title} class="related-thumb" loading="lazy" />
              </div>
            ) : (
              <div class="related-thumb-placeholder">
                <span>{post.frontmatter?.title?.charAt(0) || 'A'}</span>
              </div>
            )}
            <div class="related-info">
              <div class="related-meta">
                <time>{dateStr}</time>
                <span>•</span>
                <span>{readTime}</span>
              </div>
              <h4 class="related-title">{post.frontmatter.title}</h4>
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}

<style lang="scss">
  .related-posts {
    margin: 3.5rem auto 2rem;
    padding-top: 2rem;
    border-top: 1px solid #e2e8f0;

    .related-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.5rem;

      h3 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 700;
        color: #1e293b;
        white-space: nowrap;
      }

      .related-header-line {
        height: 2px;
        background: linear-gradient(90deg, #2b5b84, transparent);
        flex-grow: 1;
      }
    }

    .related-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.25rem;
    }

    .related-card {
      display: flex;
      flex-direction: column;
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      overflow: hidden;
      text-decoration: none;
      transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;

      &:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(43, 91, 132, 0.12);
        border-color: #2b5b84;
      }

      .related-thumb-wrapper {
        height: 120px;
        background: #f1f5f9;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;

        .related-thumb {
          width: 100%;
          height: 100%;
          object-fit: cover;
          transition: transform 0.3s ease;
        }
      }

      &:hover .related-thumb-wrapper .related-thumb {
        transform: scale(1.05);
      }

      .related-thumb-placeholder {
        height: 120px;
        background: linear-gradient(135deg, #1e2f3e, #2b5b84);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #88c0d0;
        font-size: 2.5rem;
        font-weight: bold;
      }

      .related-info {
        padding: 1rem;
        display: flex;
        flex-direction: column;
        flex-grow: 1;

        .related-meta {
          font-size: 0.78rem;
          color: #64748b;
          display: flex;
          align-items: center;
          gap: 0.4rem;
          margin-bottom: 0.5rem;
        }

        .related-title {
          font-size: 0.95rem;
          font-weight: 600;
          color: #1e293b;
          margin: 0;
          line-height: 1.4;
          display: -webkit-box;
          -webkit-line-clamp: 2;
          -webkit-box-orient: vertical;
          overflow: hidden;
        }
      }
    }
  }

  :global(.dark) .related-posts {
    border-top-color: #2a3744;

    .related-header {
      h3 {
        color: #f1f5f9;
      }
      .related-header-line {
        background: linear-gradient(90deg, #88c0d0, transparent);
      }
    }

    .related-card {
      background: #17222c;
      border-color: #263544;

      &:hover {
        border-color: #88c0d0;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
      }

      .related-thumb-wrapper {
        background: #0f171e;
      }

      .related-info {
        .related-meta {
          color: #94a3b8;
        }
        .related-title {
          color: #f1f5f9;
        }
      }
    }
  }
</style>
