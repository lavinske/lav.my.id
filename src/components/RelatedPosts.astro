---
import { getPosts, resolveThumbnail, getReadingTime } from '../utils/posts';
import moment from 'moment';
import 'moment/locale/id';
import config from '../config';

interface Props {
  currentSlug: string;
  tags?: string[];
  categories?: string[];
}

const { currentSlug, tags = [], categories = [] } = Astro.props;
const allPosts = getPosts().filter((p) => p.frontmatter?.slug !== currentSlug);

// Score candidates by overlapping tags and categories
const scored = allPosts.map((post) => {
  let score = 0;
  const postTags = post.frontmatter?.tags || [];
  const postCategories = post.frontmatter?.categories || [];

  for (const tag of tags) {
    if (postTags.includes(tag)) score += 2;
  }
  for (const cat of categories) {
    if (postCategories.includes(cat)) score += 1;
  }

  return { post, score };
});

scored.sort((a, b) => {
  if (b.score !== a.score) return b.score - a.score;
  const dateA = new Date(a.post.frontmatter?.date || 0).getTime();
  const dateB = new Date(b.post.frontmatter?.date || 0).getTime();
  return dateB - dateA;
});

const related = scored.slice(0, 3).map((item) => item.post);
---

{related.length > 0 && (
  <div class="container front-page related-container">
    <section class="section">
      <h2>Baca Selanjutnya</h2>
      <div class="posts simple">
        {related.map((post) => {
          const slug = `/${post.frontmatter.slug}/`;
          const title = post.frontmatter.title;
          const date = moment.utc(post.frontmatter.date).locale('id').format(config.dateFormat);
          const thumbnail = resolveThumbnail(post.frontmatter.thumbnail);
          const readTime = getReadingTime(post);

          return (
            <a href={slug}>
              <div class="each">
                {thumbnail ? (
                  <img src={thumbnail} alt={title} class="gatsby-image-wrapper" style="width: 50px; height: 50px; object-fit: contain; margin-bottom: 0;" />
                ) : (
                  <div />
                )}
                <div class="each-list-item">
                  <h2>{title}</h2>
                  <div class="datetime">{date} &bull; {readTime}</div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </div>
)}

<style lang="scss">
  .related-container {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid #e2e8f0;

    .section {
      margin-bottom: 1.5rem;

      h2 {
        font-size: 1.3rem;
        font-weight: 700;
        margin-bottom: 1rem;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 0.5rem;
      }
    }

    .each-list-item {
      .datetime {
        font-size: 0.82rem;
        color: #64748b;
        margin-top: 0.25rem;
      }
    }
  }

  :global(.dark) .related-container {
    border-top-color: #243442;

    .section h2 {
      border-bottom-color: #243442;
    }

    .each-list-item .datetime {
      color: #94a3b8;
    }
  }
</style>
