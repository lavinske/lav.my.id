---
import { getPosts, resolveThumbnail, getReadingTime, formatDateId } from '../utils/posts';
import config from '../config';

interface Props {
  currentSlug: string;
  tags?: string[];
  categories?: string[];
}

const { currentSlug, tags = [], categories = [] } = Astro.props;
const allPosts = getPosts().filter((p) => p.frontmatter?.slug !== currentSlug);

// Score candidates by overlapping tags and categories
const scored = allPosts.map((post) => {
  let score = 0;
  const postTags = post.frontmatter?.tags || [];
  const postCategories = post.frontmatter?.categories || [];

  for (const tag of tags) {
    if (postTags.includes(tag)) score += 2;
  }
  for (const cat of categories) {
    if (postCategories.includes(cat)) score += 1;
  }

  return { post, score };
});

scored.sort((a, b) => {
  if (b.score !== a.score) return b.score - a.score;
  const dateA = new Date(a.post.frontmatter?.date || 0).getTime();
  const dateB = new Date(b.post.frontmatter?.date || 0).getTime();
  return dateB - dateA;
});

const related = scored.slice(0, 3).map((item) => item.post);
---

{related.length > 0 && (
  <div class="container front-page related-container">
    <section class="section">
      <h2 class="section-title">Baca Selanjutnya</h2>
      <div class="posts simple">
        {related.map((post) => {
          const slug = `/${post.frontmatter.slug}/`;
          const title = post.frontmatter.title;
          const date = formatDateId(post.frontmatter.date);
          const thumbnail = resolveThumbnail(post.frontmatter.thumbnail);
          const readTime = getReadingTime(post);

          return (
            <a href={slug} class="related-post-link">
              <div class="each">
                {thumbnail ? (
                  <img src={thumbnail} alt={title} class="gatsby-image-wrapper" loading="lazy" decoding="async" width="48" height="48" style="width: 48px; height: 48px; object-fit: contain; margin-bottom: 0;" />
                ) : (
                  <div />
                )}
                <div class="each-list-item">
                  <h3 class="post-title">{title}</h3>
                  <div class="datetime">{date} &bull; {readTime}</div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </div>
)}

<style lang="scss">
  .related-container {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid #e2e8f0;

    .section {
      margin-bottom: 1.5rem;

      .section-title {
        font-family: 'Montserrat', sans-serif;
        font-size: 1.35rem;
        font-weight: 700;
        margin-bottom: 1.25rem;
        padding-bottom: 0;
        border-bottom: none !important;
        color: #0f172a;
      }
    }

    .related-post-link {
      text-decoration: none;
      display: block;

      .each {
        border-bottom: none !important;
        padding: 0.85rem 0.5rem;
        border-radius: 8px;
        transition: background 0.15s ease;

        &:hover {
          background: rgba(0, 0, 0, 0.03);

          .post-title {
            color: #2b5b84 !important;
          }
        }
      }

      .each-list-item {
        .post-title {
          font-family: 'Montserrat', sans-serif;
          font-size: 1.1rem;
          font-weight: 600;
          line-height: 1.4;
          margin: 0;
          padding: 0;
          border-bottom: none !important; // No line between title and meta
          color: #1e293b;
          transition: color 0.15s ease;
        }

        .datetime {
          font-family: 'Roboto', sans-serif;
          font-size: 0.825rem;
          color: #64748b;
          margin-top: 0.35rem;
          font-weight: 400;
        }
      }
    }
  }

  :global(.dark) .related-container {
    border-top-color: #263544;

    .section .section-title {
      color: #ffffff;
      border-bottom: none !important;
    }

    .related-post-link {
      .each {
        border-bottom: none !important;

        &:hover {
          background: rgba(255, 255, 255, 0.04);

          .post-title {
            color: #88c0d0 !important;
          }
        }
      }

      .each-list-item {
        .post-title {
          color: #f1f5f9;
          border-bottom: none !important;
        }

        .datetime {
          color: #888888;
        }
      }
    }
  }
</style>
