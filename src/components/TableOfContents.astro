---
interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: HeadingItem[];
}

const { headings = [] } = Astro.props;
const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3);

function cleanHeadingText(text: string) {
  // Strip leading numbers like "1. ", "2. ", "1) " for clean indentation styling
  return text.replace(/^\d+[\.\)]\s*/, '').trim();
}
---

{filtered.length >= 2 && (
  <>
    {/* 1. Mobile Sticky Sub-header TOC Bar (Astro Docs style) */}
    <div class="mobile-toc-bar" aria-label="Navigasi Halaman">
      <details class="mobile-toc-details" id="mobile-toc-details">
        <summary class="mobile-toc-summary">
          <span class="mobile-toc-btn">
            <span>Daftar Isi</span>
            <svg class="mobile-toc-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
          <span class="mobile-toc-current-title" id="mobile-toc-current-label">
            {cleanHeadingText(filtered[0].text)}
          </span>
        </summary>
        <div class="mobile-toc-dropdown">
          <ul class="mobile-toc-list">
            {filtered.map((heading) => (
              <li class={`mobile-toc-item depth-${heading.depth}`}>
                <a href={`#${heading.slug}`} class="mobile-toc-link" data-slug={heading.slug}>
                  <span class="mobile-toc-check" aria-hidden="true">✓</span>
                  <span class="mobile-toc-text">{cleanHeadingText(heading.text)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </div>

    {/* 2. Desktop Floating Widget (pinned on right margin) */}
    <nav class="toc-floating-widget" aria-label="Daftar Isi">
      <div class="toc-title">Daftar Isi</div>
      <ul class="toc-menu">
        {filtered.map((heading) => (
          <li class={`toc-menu-item depth-${heading.depth}`}>
            <a href={`#${heading.slug}`} class="toc-link" data-slug={heading.slug}>
              {cleanHeadingText(heading.text)}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </>
)}

<script is:inline>
  (function() {
    const desktopLinks = Array.from(document.querySelectorAll('.toc-floating-widget .toc-link'));
    const mobileLinks = Array.from(document.querySelectorAll('.mobile-toc-bar .mobile-toc-link'));
    const mobileLabel = document.getElementById('mobile-toc-current-label');
    const mobileDetails = document.getElementById('mobile-toc-details');

    const allSlugs = desktopLinks.length ? desktopLinks : mobileLinks;
    if (!allSlugs.length) return;

    const headings = allSlugs
      .map((link) => {
        const slug = link.getAttribute('data-slug');
        const el = document.getElementById(slug);
        const text = link.textContent.replace('✓', '').trim();
        return el ? { slug, el, text } : null;
      })
      .filter(Boolean);

    if (!headings.length) return;

    // Auto-close mobile dropdown on item tap
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (mobileDetails) {
          mobileDetails.removeAttribute('open');
        }
      });
    });

    // Continuous scrollspy: tracks visible section
    function onScroll() {
      const offset = 140;
      let activeItem = headings[0];

      for (let i = 0; i < headings.length; i++) {
        const rect = headings[i].el.getBoundingClientRect();
        if (rect.top <= offset) {
          activeItem = headings[i];
        } else {
          break;
        }
      }

      if (activeItem) {
        // Update desktop links
        desktopLinks.forEach((l) => {
          if (l.getAttribute('data-slug') === activeItem.slug) {
            l.classList.add('active');
          } else {
            l.classList.remove('active');
          }
        });

        // Update mobile links & label
        mobileLinks.forEach((l) => {
          if (l.getAttribute('data-slug') === activeItem.slug) {
            l.classList.add('active');
          } else {
            l.classList.remove('active');
          }
        });

        if (mobileLabel) {
          mobileLabel.textContent = activeItem.text;
        }
      }
    }

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          onScroll();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    onScroll();
  })();
</script>

<style lang="scss">
  // ==========================================
  // 1. Mobile Sticky Sub-header TOC Bar (Astro Docs style)
  // ==========================================
  .mobile-toc-bar {
    display: block;
    position: sticky;
    top: 55px; // right beneath top navbar
    z-index: 25;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid #e2e8f0;
    margin: -40px -1.5rem 2rem -1.5rem;
    padding: 0 1rem;

    .mobile-toc-details {
      position: relative;

      summary.mobile-toc-summary {
        list-style: none;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.55rem 0;
        cursor: pointer;
        user-select: none;

        &::-webkit-details-marker {
          display: none;
        }

        .mobile-toc-btn {
          display: inline-flex;
          align-items: center;
          gap: 0.35rem;
          padding: 0.25rem 0.65rem;
          font-size: 0.78rem;
          font-weight: 600;
          color: #1e293b;
          background: #f1f5f9;
          border: 1px solid #cbd5e1;
          border-radius: 9999px;
          white-space: nowrap;
          flex-shrink: 0;

          .mobile-toc-chevron {
            transition: transform 0.2s ease;
          }
        }

        .mobile-toc-current-title {
          font-size: 0.8rem;
          color: #64748b;
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
        }
      }

      &[open] summary .mobile-toc-chevron {
        transform: rotate(180deg);
      }

      .mobile-toc-dropdown {
        position: absolute;
        top: 100%;
        left: -1rem;
        right: -1rem;
        background: #ffffff;
        border-bottom: 1px solid #cbd5e1;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        max-height: 65vh;
        overflow-y: auto;
        padding: 0.75rem 1rem 1rem;

        .mobile-toc-list {
          list-style: none !important;
          margin: 0 !important;
          padding: 0 !important;

          .mobile-toc-item {
            list-style: none !important;
            margin: 0.3rem 0;

            &::before {
              display: none !important;
              content: none !important;
            }

            &.depth-3 {
              padding-left: 1.25rem;
            }

            .mobile-toc-link {
              display: flex;
              align-items: center;
              gap: 0.5rem;
              padding: 0.4rem 0.5rem;
              border-radius: 6px;
              color: #475569;
              font-size: 0.85rem;
              text-decoration: none;
              transition: all 0.15s ease;

              .mobile-toc-check {
                visibility: hidden;
                font-size: 0.75rem;
                font-weight: bold;
                color: #2b5b84;
                width: 14px;
              }

              &:hover {
                background: #f1f5f9;
                color: #0f172a;
              }

              &.active {
                background: rgba(43, 91, 132, 0.08);
                color: #2b5b84 !important;
                font-weight: 500;

                .mobile-toc-check {
                  visibility: visible;
                }
              }
            }
          }
        }
      }
    }
  }

  // Dark Theme for Mobile Bar
  :global(.dark) .mobile-toc-bar {
    background: rgba(22, 27, 34, 0.94);
    border-bottom-color: #263544;

    .mobile-toc-details {
      summary.mobile-toc-summary {
        .mobile-toc-btn {
          color: #f1f5f9;
          background: #1b242e;
          border-color: #334454;
        }

        .mobile-toc-current-title {
          color: #94a3b8;
        }
      }

      .mobile-toc-dropdown {
        background: #151b22;
        border-bottom-color: #263544;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);

        .mobile-toc-list .mobile-toc-item .mobile-toc-link {
          color: #94a3b8;

          .mobile-toc-check {
            color: #88c0d0;
          }

          &:hover {
            background: #1e2631;
            color: #ffffff;
          }

          &.active {
            background: rgba(136, 192, 208, 0.12);
            color: #88c0d0 !important;
          }
        }
      }
    }
  }

  // ==========================================
  // 2. Desktop Floating Widget (Astro Docs style)
  // ==========================================
  .toc-floating-widget {
    display: none;
  }

  @media (min-width: 1260px) {
    // Hide mobile bar on desktop
    .mobile-toc-bar {
      display: none !important;
    }

    // Show floating widget
    .toc-floating-widget {
      display: block;
      position: fixed;
      top: 130px;
      left: calc(50% + 425px);
      width: 220px;
      max-height: calc(100vh - 160px);
      overflow-y: auto;
      z-index: 50;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }

      .toc-title {
        font-size: 0.85rem;
        font-weight: 600;
        color: #0f172a;
        margin-bottom: 0.85rem;
        letter-spacing: -0.01em;
      }

      .toc-menu {
        list-style: none !important;
        padding: 0 !important;
        margin: 0 !important;

        .toc-menu-item {
          list-style: none !important;
          margin: 0.4rem 0;
          line-height: 1.45;

          &::before {
            display: none !important;
            content: none !important;
          }

          &.depth-3 {
            padding-left: 0.85rem;
          }

          .toc-link {
            display: block;
            color: #64748b; // Unselected light: clearly muted
            font-size: 0.8125rem;
            text-decoration: none;
            transition: color 0.15s ease;
            border: none !important;
            font-weight: 400 !important;

            &:hover {
              color: #0f172a; // Hover light
              text-decoration: none;
            }

            &.active {
              color: #0066ae !important; // Selected light: distinct corporate cobalt
              font-weight: 500 !important;
              border: none !important;
            }
          }
        }
      }
    }

    :global(.dark) .toc-floating-widget {
      .toc-title {
        color: #ffffff;
      }

      .toc-menu .toc-menu-item .toc-link {
        color: #7c859c; // Unselected dark: muted cool slate (Astro Docs style)

        &:hover {
          color: #e2e8f0; // Hover dark: clean bright
        }

        &.active {
          color: #88c0d0 !important; // Selected dark: vibrant frost cyan
          font-weight: 500 !important;
        }
      }
    }
  }
</style>
