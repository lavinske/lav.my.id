---
interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: HeadingItem[];
}

const { headings = [] } = Astro.props;
const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3);

function cleanHeadingText(text: string) {
  // Strip leading numbers like "1. ", "2. ", "1) " for sleek indentation
  return text.replace(/^\d+[\.\)]\s*/, '').trim();
}
---

{filtered.length >= 2 && (
  <nav class="toc-floating-widget" aria-label="Daftar Isi">
    <div class="toc-title">Daftar Isi</div>
    <ul class="toc-menu">
      {filtered.map((heading) => (
        <li class={`toc-menu-item depth-${heading.depth}`}>
          <a href={`#${heading.slug}`} class="toc-link" data-slug={heading.slug}>
            {cleanHeadingText(heading.text)}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script is:inline>
  (function() {
    const links = document.querySelectorAll('.toc-floating-widget .toc-link');
    if (!links.length) return;

    const headingEls = [];
    links.forEach((link) => {
      const slug = link.getAttribute('data-slug');
      const el = document.getElementById(slug);
      if (el) headingEls.push({ link, el });
    });

    if (!headingEls.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            links.forEach((l) => l.classList.remove('active'));
            const match = headingEls.find((h) => h.el === entry.target);
            if (match) match.link.classList.add('active');
          }
        });
      },
      { rootMargin: '-80px 0% -60% 0%', threshold: 0 }
    );

    headingEls.forEach((h) => observer.observe(h.el));
  })();
</script>

<style lang="scss">
  .toc-floating-widget {
    display: none;
  }

  // Floating widget on right side only when viewport allows (keeps article centered)
  @media (min-width: 1260px) {
    .toc-floating-widget {
      display: block;
      position: fixed;
      top: 130px;
      left: calc(50% + 425px);
      width: 220px;
      max-height: calc(100vh - 160px);
      overflow-y: auto;
      z-index: 50;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }

      .toc-title {
        font-size: 0.825rem;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 0.75rem;
        letter-spacing: -0.01em;
      }

      .toc-menu {
        list-style: none !important;
        padding: 0 !important;
        margin: 0 !important;

        .toc-menu-item {
          list-style: none !important;
          margin: 0.35rem 0;
          line-height: 1.45;

          &::before {
            display: none !important;
            content: none !important;
          }

          &.depth-3 {
            padding-left: 0.9rem;
          }

          .toc-link {
            display: block;
            color: #64748b;
            font-size: 0.8125rem;
            text-decoration: none;
            transition: color 0.15s ease;
            border: none !important;
            font-weight: 400 !important;

            &:hover {
              color: #2b5b84;
              text-decoration: none;
            }

            &.active {
              color: #2b5b84 !important;
              font-weight: 400 !important;
              border: none !important;
            }
          }
        }
      }
    }

    :global(.dark) .toc-floating-widget {
      .toc-title {
        color: #f1f5f9;
      }

      .toc-menu .toc-menu-item .toc-link {
        color: #94a3b8;

        &:hover {
          color: #88c0d0;
        }

        &.active {
          color: #88c0d0 !important;
        }
      }
    }
  }
</style>
