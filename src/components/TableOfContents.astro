---
interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: HeadingItem[];
}

const { headings = [] } = Astro.props;
const filtered = headings.filter((h) => h.depth === 2 || h.depth === 3);

function cleanHeadingText(text: string) {
  // Strip numeric prefixes like "1. ", "2. ", "1) " for clean sleek indentation
  return text.replace(/^\d+[\.\)]\s*/, '').trim();
}
---

{filtered.length >= 2 && (
  <>
    {/* 1. Mobile Sticky Sub-header TOC Bar (Astro Docs style) */}
    <div class="mobile-toc-bar" aria-label="Navigasi Halaman">
      <div class="mobile-toc-container">
        <details class="mobile-toc-details" id="mobile-toc-details">
          <summary class="mobile-toc-summary">
            <span class="mobile-toc-btn">
              <span>Daftar Isi</span>
              <svg class="mobile-toc-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
            <span class="mobile-toc-current-title" id="mobile-toc-current-label">
              {cleanHeadingText(filtered[0].text)}
            </span>
          </summary>
          <div class="mobile-toc-dropdown">
            <ul class="mobile-toc-list">
              {filtered.map((heading) => (
                <li class={`mobile-toc-item depth-${heading.depth}`}>
                  <a href={`#${heading.slug}`} class="mobile-toc-link" data-slug={heading.slug} data-title={cleanHeadingText(heading.text)}>
                    <span class="mobile-toc-check" aria-hidden="true">✓</span>
                    <span class="mobile-toc-text">{cleanHeadingText(heading.text)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </details>
      </div>
    </div>

    {/* 2. Desktop Floating Widget (pinned on right margin) */}
    <nav class="toc-floating-widget" aria-label="Daftar Isi">
      <div class="toc-title">Daftar Isi</div>
      <ul class="toc-menu">
        {filtered.map((heading) => (
          <li class={`toc-menu-item depth-${heading.depth}`}>
            <a href={`#${heading.slug}`} class="toc-link" data-slug={heading.slug} data-title={cleanHeadingText(heading.text)}>
              {cleanHeadingText(heading.text)}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </>
)}

<script is:inline>
  function setupTOCScrollspy() {
    const desktopLinks = Array.from(document.querySelectorAll('.toc-floating-widget .toc-link'));
    const mobileLinks = Array.from(document.querySelectorAll('.mobile-toc-bar .mobile-toc-link'));
    const mobileLabel = document.getElementById('mobile-toc-current-label');
    const mobileDetails = document.getElementById('mobile-toc-details');

    const sampleLinks = desktopLinks.length ? desktopLinks : mobileLinks;
    if (!sampleLinks.length) return;

    // Resolve heading elements from document
    const targets = sampleLinks
      .map((link) => {
        const slug = link.getAttribute('data-slug');
        if (!slug) return null;
        const el = document.getElementById(slug);
        const text = link.getAttribute('data-title') || (el ? el.textContent.trim() : '');
        return el ? { slug, el, text } : null;
      })
      .filter(Boolean);

    if (!targets.length) return;

    // Auto-close mobile dropdown when user selects a section
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (mobileDetails) {
          mobileDetails.removeAttribute('open');
        }
      });
    });

    // Continuous scrollspy
    function onScroll() {
      const offset = 140; // Accounts for sticky navbar + mobile bar clearance
      let current = targets[0];

      for (let i = 0; i < targets.length; i++) {
        const rect = targets[i].el.getBoundingClientRect();
        if (rect.top <= offset) {
          current = targets[i];
        } else {
          break;
        }
      }

      if (current) {
        // Desktop links highlight
        desktopLinks.forEach((l) => {
          if (l.getAttribute('data-slug') === current.slug) {
            l.classList.add('active');
          } else {
            l.classList.remove('active');
          }
        });

        // Mobile dropdown links & label highlight
        mobileLinks.forEach((l) => {
          if (l.getAttribute('data-slug') === current.slug) {
            l.classList.add('active');
          } else {
            l.classList.remove('active');
          }
        });

        if (mobileLabel && current.text) {
          mobileLabel.textContent = current.text;
        }
      }
    }

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          onScroll();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });

    // Initial highlight on page load
    onScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTOCScrollspy);
  } else {
    setupTOCScrollspy();
  }
</script>

<style lang="scss">
  // ==========================================
  // 1. Mobile Sticky Sub-header TOC Bar (Astro Docs style)
  // ==========================================
  .mobile-toc-bar {
    display: block;
    position: sticky;
    top: 55px; // directly below top fixed navbar
    z-index: 50; // below navbar (100), above article body
    width: 100%;
    margin: 0 0 1.5rem 0;
    box-sizing: border-box;
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;

    @media (min-width: 620px) {
      top: 60px;
    }

    .mobile-toc-container {
      max-width: 800px;
      margin: 0 auto;
      padding: 0.55rem 1.5rem;
      box-sizing: border-box;
    }

    .mobile-toc-details {
      position: relative;
      margin: 0;
      padding: 0;

      summary.mobile-toc-summary {
        list-style: none;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0;
        cursor: pointer;
        user-select: none;

        &::-webkit-details-marker {
          display: none;
        }

        .mobile-toc-btn {
          display: inline-flex;
          align-items: center;
          gap: 0.35rem;
          padding: 0.3rem 0.75rem;
          font-family: 'Montserrat', sans-serif;
          font-size: 0.85rem;
          font-weight: 600;
          color: #1e293b;
          background: #f1f5f9;
          border: 1px solid #cbd5e1;
          border-radius: 9999px;
          white-space: nowrap;
          flex-shrink: 0;
          transition: background 0.15s ease, border-color 0.15s ease;

          .mobile-toc-chevron {
            transition: transform 0.2s ease;
          }
        }

        .mobile-toc-current-title {
          font-family: 'Roboto', sans-serif;
          font-size: 0.875rem;
          color: #64748b;
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
        }
      }

      &[open] summary .mobile-toc-chevron {
        transform: rotate(180deg);
      }

      .mobile-toc-dropdown {
        position: absolute;
        top: calc(100% + 0.55rem);
        left: -1.5rem;
        right: -1.5rem;
        background: #ffffff;
        border-bottom: 2px solid #cbd5e1;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.1);
        max-height: 60vh;
        overflow-y: auto;
        padding: 0.75rem 1.5rem 1.25rem;

        .mobile-toc-list {
          list-style: none !important;
          margin: 0 !important;
          padding: 0 !important;

          .mobile-toc-item {
            list-style: none !important;
            margin: 0.35rem 0;

            &::before {
              display: none !important;
              content: none !important;
            }

            &.depth-2 {
              padding-left: 0;
            }
            &.depth-3 {
              padding-left: 1.25rem;
            }

            .mobile-toc-link {
              display: flex;
              align-items: center;
              gap: 0.4rem;
              padding: 0.45rem 0.6rem;
              border-radius: 6px;
              font-family: 'Roboto', sans-serif;
              font-size: 0.875rem;
              line-height: 1.45;
              color: #64748b;
              text-decoration: none;
              transition: all 0.15s ease;

              .mobile-toc-check {
                visibility: hidden;
                font-size: 0.75rem;
                font-weight: bold;
                color: #2b5b84;
                width: 14px;
                flex-shrink: 0;
              }

              &:hover {
                background: #f1f5f9;
                color: #0f172a;
              }

              &.active {
                background: rgba(43, 91, 132, 0.08);
                color: #2b5b84 !important;
                font-weight: 500;

                .mobile-toc-check {
                  visibility: visible;
                }
              }
            }
          }
        }
      }
    }
  }

  // Dark Theme for Mobile Bar
  :global(.dark) .mobile-toc-bar {
    background: #181a1f;
    border-bottom-color: #28313d;

    .mobile-toc-details {
      summary.mobile-toc-summary {
        .mobile-toc-btn {
          color: #f1f5f9;
          background: #252d38;
          border-color: #3b4959;

          &:hover {
            background: #2c3644;
          }
        }

        .mobile-toc-current-title {
          color: #94a3b8;
        }
      }

      .mobile-toc-dropdown {
        background: #181a1f;
        border-bottom-color: #28313d;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55);

        .mobile-toc-list .mobile-toc-item .mobile-toc-link {
          color: #888888;

          .mobile-toc-check {
            color: #88c0d0;
          }

          &:hover {
            background: #222b35;
            color: #ffffff;
          }

          &.active {
            background: rgba(136, 192, 208, 0.12);
            color: #88c0d0 !important;
          }
        }
      }
    }
  }

  // ==========================================
  // 2. Desktop Floating Widget (Astro Docs style)
  // ==========================================
  .toc-floating-widget {
    display: none;
  }

  @media (min-width: 1260px) {
    // Hide mobile bar on desktop
    .mobile-toc-bar {
      display: none !important;
    }

    // Show floating widget
    .toc-floating-widget {
      display: block;
      position: fixed;
      top: 130px;
      left: calc(50% + 425px);
      width: 220px;
      max-height: calc(100vh - 160px);
      overflow-y: auto;
      z-index: 40;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }

      .toc-title {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 0.85rem;
        letter-spacing: -0.01em;
      }

      .toc-menu {
        list-style: none !important;
        padding: 0 !important;
        margin: 0 !important;

        .toc-menu-item {
          list-style: none !important;
          margin: 0.45rem 0;
          line-height: 1.5;

          &::before {
            display: none !important;
            content: none !important;
          }

          &.depth-2 {
            padding-left: 0;
          }
          &.depth-3 {
            padding-left: 1rem;
          }

          .toc-link {
            display: block;
            font-family: 'Roboto', sans-serif;
            color: #64748b; // Unselected light: clearly muted
            font-size: 0.875rem; // 14px clean legible font
            text-decoration: none;
            transition: color 0.15s ease;
            border: none !important;
            font-weight: 400 !important;

            &:hover {
              color: #0f172a; // Hover light
              text-decoration: none;
            }

            &.active {
              color: #2b5b84 !important; // Selected light: Nordic Steel Blue
              font-weight: 500 !important;
              border: none !important;
            }
          }
        }
      }
    }

    :global(.dark) .toc-floating-widget {
      .toc-title {
        color: #ffffff;
      }

      .toc-menu .toc-menu-item .toc-link {
        color: #888888; // Unselected dark: muted slate

        &:hover {
          color: #ffffff; // Hover dark: clean white
        }

        &.active {
          color: #88c0d0 !important; // Selected dark: vibrant Nordic frost cyan
          font-weight: 500 !important;
        }
      }
    }
  }
</style>
